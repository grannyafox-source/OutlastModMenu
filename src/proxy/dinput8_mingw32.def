    DllRegisterServer=Proxy_DllRegisterServer@0 PRIVATE
    DllUnregisterServer=Proxy_DllUnregisterServer@0 PRIVATE
    GetdfDIJoystick=Proxy_GetdfDIJoystick@0
    OMM_GetApi
